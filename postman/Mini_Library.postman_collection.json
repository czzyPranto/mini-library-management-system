{
  "info": {
    "name": "Mini Library Management System — Django REST Framework",
    "description": "Backend-only course demo: 4 custom models; CRUD, filters, search, pagination, nested serializers, input validation. Execute create requests first to capture IDs; do deletes last. Basic auth credentials are for localhost demos only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const today = new Date();",
          "const dateString = d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,\"0\")}-${String(d.getDate()).padStart(2,\"0\")}`;",
          "const due = new Date(today);",
          "due.setDate(due.getDate() + 14);",
          "pm.collectionVariables.set(\"today\", dateString(today));",
          "pm.collectionVariables.set(\"due_date\", dateString(due));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": "library_admin"
    },
    {
      "key": "password",
      "value": "LibraryDemo123!"
    },
    {
      "key": "unassigned_user_id",
      "value": "2"
    },
    {
      "key": "author_id",
      "value": "1"
    },
    {
      "key": "member_id",
      "value": "1"
    },
    {
      "key": "book_id",
      "value": "5"
    },
    {
      "key": "loan_id",
      "value": "1"
    },
    {
      "key": "today",
      "value": "2026-11-13"
    },
    {
      "key": "due_date",
      "value": "2026-11-27"
    }
  ],
  "item": [
    {
      "name": "01 Authors CRUD",
      "item": [
        {
          "name": "01 GET all authors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/authors/",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 POST create author",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/authors/",
            "description": "Run this before author retrieve/PUT/PATCH/DELETE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada@example.local\",\n  \"bio\": \"First programmer (sample)\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"author_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 GET one author",
